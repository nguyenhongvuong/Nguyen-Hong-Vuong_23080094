  .empty{
    border:1px dashed var(--paper-line); border-radius:var(--radius);
    padding: 30px; text-align:center; color:#8a8272; font-size:14px;
  }
 
  form{ background:#fff; border:1px solid var(--paper-line); border-radius:var(--radius); padding:20px; }
  .field{ margin-bottom:16px; }
  .field label{ display:block; font-size:13px; font-weight:600; margin-bottom:6px; color:#374151; }
  .field .fixed{
    background: var(--amber-soft); color:#5c3b12; font-weight:600;
    padding:10px 12px; border-radius:7px; font-size:14px;
  }
  input[type=text], input[type=tel], input[type=email]{
    width:100%; padding:10px 12px; border:1px solid #d8d2c2; border-radius:7px;
    font-family:'Inter'; font-size:14px; background:#fffdf8;
  }
  input:focus{ outline:2px solid var(--navy); outline-offset:1px; }
  .btn-primary{
    width:100%; padding:12px; border:none; border-radius:7px;
    background: var(--green); color:#fff; font-weight:700; font-size:14.5px;
    cursor:pointer; font-family:'Inter';
  }
  .btn-primary:hover{ filter:brightness(1.06); }
  .btn-secondary{
    background:none; border:1px solid var(--paper-line); color:#6b7280;
    padding:9px 14px; border-radius:7px; font-size:13px; cursor:pointer; font-weight:600;
  }
 
  .confirm-card{
    background:#fff; border:1px solid var(--paper-line); border-radius: var(--radius);
    padding:28px 24px; text-align:center;
  }
  .confirm-card .check{
    width:48px; height:48px; border-radius:50%; background: var(--green);
    color:#fff; display:flex; align-items:center; justify-content:center;
    margin: 0 auto 14px; font-size:22px;
  }
  .confirm-card h2{ font-family:'Fraunces'; font-size:20px; margin:0 0 6px; color:var(--navy); }
  .confirm-details{
    text-align:left; background: var(--paper); border-radius:8px; padding:14px 16px;
    margin: 16px 0; font-size:13.5px; line-height:1.9;
  }
  .confirm-details b{ color: var(--navy); }
 
  .admin-add{ background:#fff; border:1px solid var(--paper-line); border-radius:var(--radius); padding:18px; margin-bottom:20px; }
  .admin-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:12px; }
  .admin-row{
    display:flex; align-items:center; justify-content:space-between;
    background:#fff; border:1px solid var(--paper-line); border-radius:var(--radius);
    padding:12px 16px; margin-bottom:8px;
  }
  .admin-row .status{
    font-size:11px; font-weight:700; padding:3px 9px; border-radius:999px;
    text-transform:uppercase; letter-spacing:.04em;
  }
  .status.open{ background:#dcefe2; color: var(--green); }
  .status.taken{ background:#f6dcd8; color: var(--red); }
  .del-btn{
    border:none; background:none; color:#b5493f; font-size:13px; font-weight:600;
    cursor:pointer;
  }
 
  footer{
    text-align:center; padding:20px; color:#a49c8a; font-size:12px;
  }
</style>
</head>
<body>
 
<header>
  <div class="header-inner">
    <div class="eyebrow">Trung tâm gia sư · Demo</div>
    <h1>Đặt lịch học cùng gia sư</h1>
    <p class="sub">Chọn khung giờ trống, điền thông tin, và giữ chỗ học của bạn chỉ trong một phút.</p>
  </div>
  <nav>
    <button class="active" data-view="lich">Xem lịch trống</button>
    <button data-view="quanly">Quản lý (Admin)</button>
  </nav>
</header>
 
<main>
 
  <!-- VIEW: XEM LỊCH -->
  <section class="view active" id="view-lich">
    <p class="section-label">Khung giờ trống</p>
    <p class="section-note">Chọn một khung giờ để bắt đầu đặt lịch. Khung giờ đã đặt sẽ được đánh dấu.</p>
    <div class="slot-list" id="slot-list"></div>
  </section>
 
  <!-- VIEW: FORM ĐẶT LỊCH -->
  <section class="view" id="view-form">
    <p class="section-label">Điền thông tin đặt lịch</p>
    <p class="section-note">Khung giờ đã chọn sẽ được giữ trong 10 phút.</p>
    <form id="booking-form">
      <div class="field">
        <label>Khung giờ đã chọn</label>
        <div class="fixed" id="chosen-slot-display">—</div>
      </div>
      <div class="field">
        <label for="f-name">Họ và tên</label>
        <input type="text" id="f-name" required placeholder="Nguyễn Văn A">
      </div>
      <div class="field">
        <label for="f-phone">Số điện thoại</label>
        <input type="tel" id="f-phone" required placeholder="09xx xxx xxx">
      </div>
      <div class="field">
        <label for="f-email">Email (không bắt buộc)</label>
        <input type="email" id="f-email" placeholder="ban@email.com">
      </div>
      <button type="submit" class="btn-primary">Xác nhận đặt lịch</button>
    </form>
    <div style="margin-top:12px;">
      <button class="btn-secondary" id="back-to-list">← Quay lại chọn khung giờ khác</button>
    </div>
  </section>
 
  <!-- VIEW: XÁC NHẬN -->
  <section class="view" id="view-confirm">
    <div class="confirm-card">
      <div class="check">✓</div>
      <h2>Đặt lịch thành công!</h2>
      <p class="section-note" style="margin:0;">Gia sư sẽ liên hệ xác nhận trước buổi học.</p>
      <div class="confirm-details" id="confirm-details"></div>
      <button class="btn-secondary" id="back-home">Về trang xem lịch</button>
    </div>
  </section>
 
  <!-- VIEW: QUẢN LÝ -->
  <section class="view" id="view-quanly">
    <p class="section-label">Quản lý khung giờ</p>
    <p class="section-note">Thêm khung giờ mới cho học viên đặt, hoặc xóa khung giờ không còn dạy.</p>
 
    <div class="admin-add">
      <div class="admin-grid">
        <div class="field" style="margin-bottom:10px;">
          <label for="a-date">Ngày</label>
          <input type="text" id="a-date" placeholder="VD: 12/08/2026">
        </div>
        <div class="field" style="margin-bottom:10px;">
          <label for="a-time">Giờ</label>
          <input type="text" id="a-time" placeholder="VD: 18:00 - 19:00">
        </div>
      </div>
      <div class="field" style="margin-bottom:12px;">
        <label for="a-subject">Môn học</label>
        <input type="text" id="a-subject" placeholder="VD: Toán lớp 9">
      </div>
      <button class="btn-primary" id="add-slot-btn" style="background:var(--navy);">+ Thêm khung giờ</button>
    </div>
 
    <p class="section-label" style="font-size:16px;">Danh sách hiện có</p>
    <div id="admin-list"></div>
  </section>
 
</main>
 
<footer>Bài tập thực hành AI — Website đặt lịch gia sư (dữ liệu mẫu, không kết nối máy chủ thật)</footer>
 
<script>
  // ===== MOCK DATA =====
  let slots = [
    { id: 1, date: "10/08/2026", time: "18:00 - 19:00", subject: "Toán lớp 9", status: "trống" },
    { id: 2, date: "10/08/2026", time: "19:30 - 20:30", subject: "Tiếng Anh giao tiếp", status: "trống" },
    { id: 3, date: "11/08/2026", time: "17:00 - 18:00", subject: "Lý lớp 11", status: "đã đặt" },
    { id: 4, date: "12/08/2026", time: "20:00 - 21:00", subject: "Toán lớp 9", status: "trống" },
  ];
  let nextId = 5;
  let selectedSlotId = null;
 
  // ===== NAV =====
  const navButtons = document.querySelectorAll('nav button');
  const views = document.querySelectorAll('.view');
  function showView(id){
    views.forEach(v => v.classList.remove('active'));
    document.getElementById('view-' + id).classList.add('active');
  }
  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      navButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      showView(btn.dataset.view);
      if(btn.dataset.view === 'quanly') renderAdminList();
    });
  });
 
  // ===== RENDER: DANH SÁCH KHUNG GIỜ (khách hàng) =====
  function renderSlotList(){
    const list = document.getElementById('slot-list');
    list.innerHTML = '';
    if(slots.length === 0){
      list.innerHTML = '<div class="empty">Hiện chưa có khung giờ nào. Vui lòng quay lại sau.</div>';
      return;
    }
    slots.forEach(s => {
      const div = document.createElement('div');
      div.className = 'slot' + (s.status === 'đã đặt' ? ' booked' : '');
      div.innerHTML = `
        <div class="meta">
          <span class="date">${s.date} · ${s.subject}</span>
          <span class="time-tag">${s.time}</span>
        </div>
        ${s.status === 'trống' ? `<button data-id="${s.id}">Chọn giờ này</button>` : ''}
      `;
      list.appendChild(div);
    });
    list.querySelectorAll('button[data-id]').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedSlotId = Number(btn.dataset.id);
        openBookingForm();
      });
    });
  }
 
  // ===== FORM ĐẶT LỊCH =====
  function openBookingForm(){
    const slot = slots.find(s => s.id === selectedSlotId);
    document.getElementById('chosen-slot-display').textContent =
      `${slot.date} · ${slot.time} · ${slot.subject}`;
    showView('form');
  }
  document.getElementById('back-to-list').addEventListener('click', () => {
    showView('lich');
  });
 
  document.getElementById('booking-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const slot = slots.find(s => s.id === selectedSlotId);
    if(!slot || slot.status === 'đã đặt'){
      alert('Khung giờ này vừa được đặt bởi người khác. Vui lòng chọn khung giờ khác.');
      showView('lich');
      renderSlotList();
      return;
    }
    const name = document.getElementById('f-name').value.trim();
    const phone = document.getElementById('f-phone').value.trim();
    const email = document.getElementById('f-email').value.trim();
 
    slot.status = 'đã đặt';
 
    document.getElementById('confirm-details').innerHTML = `
      <div><b>Học viên:</b> ${name}</div>
      <div><b>Số điện thoại:</b> ${phone}</div>
      ${email ? `<div><b>Email:</b> ${email}</div>` : ''}
      <div><b>Ngày:</b> ${slot.date}</div>
      <div><b>Giờ:</b> ${slot.time}</div>
      <div><b>Môn học:</b> ${slot.subject}</div>
    `;
    showView('confirm');
    document.getElementById('booking-form').reset();
    renderSlotList();
  });
 
  document.getElementById('back-home').addEventListener('click', () => {
    navButtons.forEach(b => b.classList.remove('active'));
    document.querySelector('[data-view="lich"]').classList.add('active');
    showView('lich');
  });
 
  // ===== ADMIN: QUẢN LÝ KHUNG GIỜ =====
  function renderAdminList(){
    const list = document.getElementById('admin-list');
    list.innerHTML = '';
    if(slots.length === 0){
      list.innerHTML = '<div class="empty">Chưa có khung giờ nào.</div>';
      return;
    }
    slots.forEach(s => {
      const row = document.createElement('div');
      row.className = 'admin-row';
      row.innerHTML = `
        <div class="meta">
          <span class="date">${s.date} · ${s.time}</span>
          <span class="subject">${s.subject}</span>
        </div>
        <div style="display:flex; align-items:center; gap:12px;">
          <span class="status ${s.status === 'trống' ? 'open' : 'taken'}">${s.status}</span>
          <button class="del-btn" data-id="${s.id}">Xóa</button>
        </div>
      `;
      list.appendChild(row);
    });
    list.querySelectorAll('.del-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        slots = slots.filter(s => s.id !== Number(btn.dataset.id));
        renderAdminList();
        renderSlotList();
      });
    });
  }
 
  document.getElementById('add-slot-btn').addEventListener('click', () => {
    const date = document.getElementById('a-date').value.trim();
    const time = document.getElementById('a-time').value.trim();
    const subject = document.getElementById('a-subject').value.trim();
    if(!date || !time || !subject){
      alert('Vui lòng nhập đủ Ngày, Giờ và Môn học.');
      return;
    }
    slots.push({ id: nextId++, date, time, subject, status: 'trống' });
    document.getElementById('a-date').value = '';
    document.getElementById('a-time').value = '';
    document.getElementById('a-subject').value = '';
    renderAdminList();
    renderSlotList();
  });
 
  // ===== INIT =====
  renderSlotList();
</script>
 
</body>
</html>

Câu hỏi cần trả lời

1. AI hỗ trợ bạn tốt nhất ở bước nào?

AI hỗ trợ tốt nhất ở bước Design/Planning — giúp phác thảo nhanh cấu trúc trang (5 trang: xem lịch, đặt lịch, xác nhận, quản lý) và luồng hoạt động của người dùng chỉ trong vài giây, thay vì phải tự nghĩ từ đầu. Ở bước Coding, AI cũng giúp tiết kiệm thời gian viết code khung (HTML/CSS/JS) rất nhiều so với gõ tay từ đầu.
2. AI đã tạo ra kết quả sai hoặc chưa phù hợp ở đâu?
- Form đặt lịch chưa kiểm tra định dạng số điện thoại (nhập chữ vẫn được chấp nhận)
- Nếu bấm "Xác nhận đặt lịch" nhiều lần liên tiếp nhanh, có thể xảy ra tình trạng đặt trùng khung giờ (do không có debounce/khóa)
- Dữ liệu chỉ lưu tạm trong bộ nhớ trình duyệt — tải lại trang là mất hết (giới hạn do yêu cầu "không cần database thật", nhưng cần ghi rõ đây là hạn chế)
3. Bạn đã phải kiểm tra và chỉnh sửa kết quả của AI như thế nào?
Mở file trên trình duyệt, thử đầy đủ luồng: xem lịch → đặt lịch → xác nhận → kiểm tra khung giờ chuyển trạng thái
Thử thêm/xóa khung giờ ở trang Admin để kiểm tra dữ liệu đồng bộ giữa 2 trang
4. Theo bạn, trong quy trình trên con người và AI nên đảm nhận vai trò gì?
AI phù hợp để tăng tốc các việc lặp lại và tốn thời gian gõ tay: phác thảo cấu trúc, sinh code khung, gợi ý luồng hoạt động. Con người vẫn phải giữ vai trò quyết định và kiểm soát chất lượng: xác định đúng bài toán và yêu cầu thực tế ban đầu, kiểm tra logic có đúng không, phát hiện lỗi AI bỏ sót (như validate dữ liệu, xử lý tình huống trùng lặp), và đảm bảo hiểu rõ toàn bộ sản phẩm để có thể giải thích khi được hỏi. AI là công cụ hỗ trợ, không thay thế được việc con người hiểu và chịu trách nhiệm về kết quả cuối cùng.
