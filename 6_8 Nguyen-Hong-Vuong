    border-radius:50%;
    background: radial-gradient(circle, var(--amber) 0%, transparent 70%);
    opacity:.35;
  }
  .header-inner{ max-width: 760px; margin:0 auto; position:relative; }
  .eyebrow{
    font-size:12px; letter-spacing:.14em; text-transform:uppercase;
    color: var(--amber-soft); font-weight:600; margin-bottom:8px;
  }
  h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size: clamp(28px, 5vw, 38px);
    margin: 0 0 6px;
    line-height:1.15;
  }
  .sub{ color:#cdd6e6; font-size:15px; max-width:46ch; }
 
  nav{
    max-width:760px; margin: 18px auto 0; display:flex; gap:8px;
    position:relative;
  }
  nav button{
    font-family:'Inter',sans-serif; font-weight:600; font-size:13.5px;
    padding:9px 16px; border-radius: 999px; border:1px solid rgba(255,255,255,.25);
    background: rgba(255,255,255,.08); color:#fff; cursor:pointer;
